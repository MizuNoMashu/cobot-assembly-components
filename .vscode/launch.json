{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Flask Cobot Server",
      "type": "python",
      "request": "launch",
      "module": "app.server",
      "python": "${workspaceFolder}/cobot/venv/bin/python",
      "cwd": "${workspaceFolder}/cobot",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/credential.env",
      "env": {
        "FLASK_ENV": "development",
        "PYTHONUNBUFFERED": "1"
      },
      "args": []
    }
  ]
}
